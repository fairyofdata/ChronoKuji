# ==========================================
# 🔮 O_miku_Z Production .gitignore
# ==========================================

# 1. Environment & Security
.env
.env.local
.env.*.local
*.pem
*.key
.firebase/

# 2. Database & Data Stores
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
test.db

# 3. Audio & Protected Media Assets (Copyright Protection)
*.mp3
*.wav
*.flac
*.aac
audio_source/
frontend/public/assets/audio/bgm/*.mp3
frontend/public/assets/audio/bgm/extra/*.mp3
frontend/src/*.mp3

# 4. Python Environment & Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
env/
ENV/
.venv/
.pytest_cache/
.coverage
htmlcov/

# 5. Node.js & Frontend Build Artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
frontend/node_modules/
frontend/dist/
frontend/dev-dist/
frontend/.vite/
.pwa-cache/

# 6. IDE & Editor Specific Files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vim/

# 7. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 8. Temporary & Log Files
logs/
*.log
scratch/